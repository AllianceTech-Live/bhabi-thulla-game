# Supabase (required for online multiplayer)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Never put the service-role key in the mobile app.
# Service role is only for Edge Functions / server environments.

# AdMob. App IDs are baked at build time via app.config.js.
# Get these from AdMob → Apps → App settings / Ad units.
# Create a separate iOS app in AdMob (do not reuse Android App ID).
# ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxx~yyyyyyyy
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-xxxxxxxx/zzzzzzzz
# EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_UNIT_ID=ca-app-pub-xxxxxxxx/wwwwwwww
# ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxx~yyyyyyyy
# EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-xxxxxxxx/zzzzzzzz
# EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_UNIT_ID=ca-app-pub-xxxxxxxx/wwwwwwww
